# audio takes and streamed data — large, keep out of git
logs/**
!logs/.gitkeep
# ...but the JSON log records themselves are small and ARE the result. Process rule 11
# says a result without its parameter set is not a result; gitignoring the records would
# delete exactly that on any clone, leaving orphan wavs nobody can attribute. The audio
# stays out via the *.wav rule below.
!logs/**/
!logs/**/*.json
*.wav
*.aif
*.aiff
*.flac
*.npy
*.npz

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# macos
.DS_Store

# bela build artifacts
*.o
*.d
build/
